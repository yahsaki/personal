syntax on
"idk wtf this is
"set backspace=indent,eol,start
set ruler
set number
set showcmd
set incsearch
set hlsearch
set nowrap
set cursorline

set tabstop=2
set shiftwidth=2
set expandtab
set smarttab

set termwinsize=12x0
set splitbelow
set mouse=a

